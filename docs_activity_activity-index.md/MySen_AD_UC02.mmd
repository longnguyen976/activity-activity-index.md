flowchart TD
  %% Mermaid subgraphs = activity partitions (course Pattern C fallback).
  subgraph ACT["Visitor / GenZ Customer"]
    start@{ shape: sm-circ }
    a1("Browse e-ticket catalogue")
    a2("Select ticket type and quantity")
    a3("Select MoMo or VNPay")
    a4("Complete payment at provider")
    a5("View issued QR e-ticket")
    end_paid@{ shape: fr-circ }
    end_failed@{ shape: fr-circ }
    end_expired@{ shape: fr-circ }
    end_duplicate@{ shape: fr-circ }
    end_policy@{ shape: fr-circ }
  end
  subgraph SYS["MySen App Platform"]
    s1("Display available tickets, prices and conditions (FR-02-01)")
    s2("Create PENDING order with unique ID and total (FR-02-02)")
    s3("Create payment transaction and return checkout (FR-02-03)")
    m_wait{" "}
    d_event{"Which event is observed first?"}
    t1@{ shape: hourglass }
    s_expire("Set unpaid order EXPIRED; prevent issuance (FR-02-06)")
    s_verify("Verify callback signature, ID, amount and replay (FR-02-07)")
    d_callback{"Callback acceptable for PENDING order?"}
    d_payment{"What verified payment result?"}
    s_paid("Mark payment SUCCESS and order PAID once (FR-02-04)")
    s_fail("Record FAILED/CANCELLED; issue no ticket; notify (FR-02-05)")
    s_issue("Issue visitor-linked e-tickets (FR-02-08)")
    s_qr("Generate secure QR credential (FR-02-09)")
    o_ticket["E-ticket [ISSUED] with QR"]
  end
  subgraph GATE["Payment Gateway (MoMo/VNPay)"]
    g_checkout("Return payment URL or token")
    g_callback("Deliver payment result callback")
  end

  start --> a1
  a1 --> s1
  s1 --> a2
  a2 --> s2
  s2 --> a3
  a3 --> s3
  s3 --> g_checkout
  g_checkout --> a4
  a4 --> m_wait
  m_wait --> d_event
  d_event -->|"[payment webhook received]"| g_callback
  d_event -->|"[15 min elapsed; PENDING and no verified SUCCESS]"| t1
  t1 -->|"15 minutes after order creation"| s_expire
  s_expire --> end_expired
  g_callback --> s_verify
  s_verify --> d_callback
  d_callback -->|"[valid new callback for PENDING order]"| d_payment
  d_callback -->|"[invalid or mismatched; still PENDING]"| m_wait
  d_callback -->|"[already processed duplicate]"| end_duplicate
  d_callback -->|"[late SUCCESS after EXPIRED or other terminal-state event]"| end_policy
  d_payment -->|"[SUCCESS]"| s_paid
  d_payment -->|"[FAILED or CANCELLED]"| s_fail
  d_payment -->|"[other payment status]"| m_wait
  s_fail --> end_failed
  s_paid --> s_issue
  s_issue --> s_qr
  s_qr --> o_ticket
  o_ticket --> a5
  a5 --> end_paid
